    <string name="tutorial_live_title">Acessível só ao vivo</string>
    <string name="tutorial_live_body">O Whospair não deixa nada esperando em um servidor. Uma mensagem sai quando seu contato está com o aplicativo aberto ou ativou “Continuar acessível”.</string>
    <string name="tutorial_live_f1">O ponto ao lado do Tor: verde, você está on-line; laranja, conectando</string>
    <string name="tutorial_live_f2">A primeira conexão pode levar alguns segundos, às vezes um minuto</string>
    <string name="tutorial_live_f3">“acessível” sob um nome: o contato está lá, agora</string>
    <string name="tutorial_confirm_title">Confirmar um contato</string>
    <string name="tutorial_confirm_body">Um escaneamento basta para conversar. Mas quem tem apenas o seu link chega como “A confirmar”.</string>
    <string name="tutorial_confirm_f1">Compare o número de segurança, pessoalmente ou por chamada</string>
    <string name="tutorial_confirm_f2">Mesmo número nos dois telefones: ninguém no meio</string>
    <string name="tutorial_confirm_f3">Só contatos confirmados podem ligar para você e dar um toque</string>
    <string name="tutorial_discreet_title">Discrição</string>
    <string name="tutorial_discreet_body">Proteções para os momentos em que alguém está ao seu lado.</string>
    <string name="tutorial_discreet_f1">Telefone virado para baixo na mesa: a tela fica preta</string>
