    <string name="tutorial_confirm_f2">Rovnaké číslo na oboch telefónoch: nikto medzi vami</string>
    <string name="tutorial_confirm_f3">Volať Vám a dávať znamenie môžu len potvrdené kontakty</string>
    <string name="tutorial_discreet_title">Diskrétnosť</string>
    <string name="tutorial_discreet_body">Ochrana pre chvíle, keď je niekto vedľa Vás.</string>
    <string name="tutorial_discreet_f1">Telefón položený obrazovkou na stôl: obrazovka sčernie</string>
