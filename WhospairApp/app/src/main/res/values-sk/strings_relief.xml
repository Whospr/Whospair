    <string name="tutorial_live_f3">„dostupný/á“ pod menom: kontakt je tam, práve teraz</string>
    <string name="tutorial_confirm_title">Potvrdenie kontaktu</string>
    <string name="tutorial_confirm_body">Na rozhovor stačí jedno naskenovanie. Ale ten, kto má len Váš odkaz, sa zobrazí ako „Na potvrdenie“.</string>
