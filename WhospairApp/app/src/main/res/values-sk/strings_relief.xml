    <string name="tutorial_live_title">Dostupný/á len naživo</string>
    <string name="tutorial_live_body">Whospair nenecháva nič čakať na serveri. Správa odíde, keď má Váš kontakt aplikáciu otvorenú alebo zapol „Zostať dostupný“.</string>
    <string name="tutorial_live_f1">Bodka vedľa Tor: zelená, ste online; oranžová, pripája sa</string>
