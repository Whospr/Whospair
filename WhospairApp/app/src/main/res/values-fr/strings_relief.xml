    <string name="tutorial_live_title">Joignable seulement en direct</string>
    <string name="tutorial_live_body">Whospair ne garde rien en attente sur un serveur. Un message part quand votre contact a l\'app ouverte, ou quand il a activé « Rester joignable ».</string>
    <string name="tutorial_live_f1">Le point à côté de Tor : vert, vous êtes en ligne ; orange, connexion en cours</string>
    <string name="tutorial_live_f2">La première connexion peut prendre quelques secondes, parfois une minute</string>
    <string name="tutorial_live_f3">« joignable » sous un nom : le contact est là, maintenant</string>
    <string name="tutorial_confirm_title">Confirmer un contact</string>
    <string name="tutorial_confirm_body">Un seul scan suffit pour se parler. Mais quelqu\'un qui a seulement votre lien arrive comme « À confirmer ».</string>
    <string name="tutorial_confirm_f1">Comparez le numéro de sécurité, en personne ou par un appel</string>
    <string name="tutorial_confirm_f2">Même numéro sur les deux téléphones : personne au milieu</string>
    <string name="tutorial_confirm_f3">Seuls les contacts confirmés peuvent vous appeler et vous faire signe</string>
    <string name="tutorial_discreet_title">Discrétion</string>
    <string name="tutorial_discreet_body">Des protections pour les moments où quelqu\'un est à côté de vous.</string>
    <string name="tutorial_discreet_f1">Téléphone retourné sur la table : l\'écran devient noir</string>
