    <string name="tutorial_live_title">Chỉ liên lạc được khi trực tiếp</string>
    <string name="tutorial_live_body">Whospair không để gì chờ trên máy chủ. Tin nhắn chỉ đi khi liên hệ của bạn đang mở ứng dụng, hoặc đã bật «Luôn có thể liên lạc».</string>
    <string name="tutorial_live_f1">Chấm cạnh Tor: xanh lá là bạn đang trực tuyến; cam là đang kết nối</string>
    <string name="tutorial_live_f2">Lần kết nối đầu có thể mất vài giây, đôi khi một phút</string>
    <string name="tutorial_live_f3">«có thể liên lạc» dưới một cái tên: liên hệ đang ở đó, ngay lúc này</string>
    <string name="tutorial_confirm_title">Xác nhận liên hệ</string>
    <string name="tutorial_confirm_body">Chỉ cần quét một lần là trò chuyện được. Nhưng người chỉ có liên kết của bạn sẽ hiện là «Chờ xác nhận».</string>
    <string name="tutorial_confirm_f1">Đối chiếu mã an toàn khi gặp trực tiếp hoặc qua cuộc gọi</string>
    <string name="tutorial_confirm_f2">Cùng một mã trên hai điện thoại: không ai ở giữa</string>
    <string name="tutorial_confirm_f3">Chỉ liên hệ đã xác nhận mới có thể gọi và ra hiệu cho bạn</string>
    <string name="tutorial_discreet_title">Kín đáo</string>
    <string name="tutorial_discreet_body">Bảo vệ cho những lúc có người ở bên cạnh bạn.</string>
    <string name="tutorial_discreet_f1">Úp điện thoại xuống bàn: màn hình tối đen</string>
    <string name="tutorial_discreet_f2">Mã đọc: cuộc trò chuyện được ẩn cho đến khi nhập mã</string>
    <string name="tutorial_discreet_f3">Chế độ riêng tư: liên hệ này chỉ liên lạc được với bạn khi bạn nhắn cho họ</string>
