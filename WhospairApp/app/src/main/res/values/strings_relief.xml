    <string name="tutorial_live_title">Reachable only live</string>
    <string name="tutorial_live_body">Whospair keeps nothing waiting on a server. A message leaves when your contact has the app open, or has turned on “Stay reachable”.</string>
    <string name="tutorial_live_f1">The dot next to Tor: green, you are online; orange, connecting</string>
    <string name="tutorial_live_f2">The first connection can take a few seconds, sometimes a minute</string>
    <string name="tutorial_live_f3">“reachable” under a name: the contact is there, right now</string>
    <string name="tutorial_confirm_title">Confirming a contact</string>
    <string name="tutorial_confirm_body">One scan is enough to talk. But someone who only has your link arrives as “To confirm”.</string>
    <string name="tutorial_confirm_f1">Compare the safety number, in person or on a call</string>
    <string name="tutorial_confirm_f2">Same number on both phones: no one in between</string>
    <string name="tutorial_confirm_f3">Only confirmed contacts can call you and nudge you</string>
    <string name="tutorial_discreet_title">Discretion</string>
    <string name="tutorial_discreet_body">Protections for the moments when someone is next to you.</string>
    <string name="tutorial_discreet_f1">Phone turned face down on the table: the screen goes black</string>
    <string name="tutorial_discreet_f2">Reading code: a conversation stays hidden until the code</string>
    <string name="tutorial_discreet_f3">Private mode: this contact can only reach you when you write to them</string>
